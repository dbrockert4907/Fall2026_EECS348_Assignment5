/*
 * Program: EECS 348 Assignment 4 - Sudoku Solver
 * Description: Solves Sudoku puzzles with recursive, object-oriented
 *              backtracking and writes every solution to an output file.
 * Inputs: puzzle1.txt - puzzle5.txt (9 rows, digits or "_" for blank)
 * Outputs: solution1.txt - solution5.txt; each contains all solutions and
 *          a final solution count, or exactly "No solution found." if none.
 * Collaborators: ChatGPT and Gemini (source code generated by both tools);
 *                Claude (Anthropic) for review and guidance;
 * Other sources: ChatGPT, Gemini, Claude
 * Original author: Josselyn Bui
 * Creation date: 10/15/2026
 * Revised by: Dalton Brockert
 * Revision date: 10/29/2026
 *
 * Inherited code: SudokuSolver class structure, isValid(), findNextEmpty(),
 *                 recursive backtracking approach, and basic file loading.
 * Modified code: output-stream handling, strict input validation, output-file
 *                 generation, robust error handling, and solution formatting.
 */

#include <iostream>   // cout and cerr, used for status and error messages
#include <fstream>    // ifstream and ofstream, used for file input and output
#include <vector>     // holds the five input file names
#include <string>     // stores file names and input symbols

// ---------------------------------------------------------------------
// Block: SudokuSolver class
// Original class structure retained from Josselyn Bui's Assignment 4.
// Revisions by Dalton Brockert are marked in the comments below.
// ---------------------------------------------------------------------
class SudokuSolver {
private:
    int grid[9][9];       // the board; 0 means the cell is empty
    int solutionCount;    // how many complete solutions have been found

    // Inherited: checks whether num conflicts with a row, column, or block.
    bool isValid(int row, int col, int num) const {
        for (int c = 0; c < 9; ++c) {
            if (grid[row][c] == num) {
                return false;
            }
        }

        for (int r = 0; r < 9; ++r) {
            if (grid[r][col] == num) {
                return false;
            }
        }

        int startRow = (row / 3) * 3;
        int startCol = (col / 3) * 3;
        for (int r = 0; r < 3; ++r) {
            for (int c = 0; c < 3; ++c) {
                if (grid[startRow + r][startCol + c] == num) {
                    return false;
                }
            }
        }

        return true;
    }

    // Inherited from the original program: checks that the original clues
    // do not already contain duplicate digits in a row, column, or 3x3 block.
    bool cluesConsistent() {
        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                int digit = grid[r][c];
                if (digit == 0) {
                    continue;
                }
                grid[r][c] = 0;                 // temporarily lift the clue
                bool ok = isValid(r, c, digit);  // check against other clues
                grid[r][c] = digit;              // restore the clue
                if (!ok) {
                    return false;
                }
            }
        }
        return true;
    }

    // Inherited: finds the first empty cell, scanning row by row.
    bool findNextEmpty(int &row, int &col) const {
        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                if (grid[r][c] == 0) {
                    row = r;
                    col = c;
                    return true;
                }
            }
        }
        return false;
    }

    // MODIFIED BY DALTON BROCKERT:
    // Writes each completed grid directly to the selected output stream.
    // No solution labels are written, so each grid retains input-file format.
    void printGrid(std::ostream &out) const {
        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                if (grid[r][c] == 0) {
                    out << "_";
                } else {
                    out << grid[r][c];
                }
                if (c < 8) {
                    out << " ";
                }
            }
            out << "\n";
        }
    }

    // Inherited recursive backtracking, modified by Dalton Brockert to send
    // every solution to the output file instead of stopping at the first.
    void solveRecursive(std::ostream &out) {
        int row = -1;
        int col = -1;

        if (!findNextEmpty(row, col)) {
            ++solutionCount;
            printGrid(out);              // MODIFIED: solution goes to file
            return;                      // continue searching other branches
        }

        for (int val = 1; val <= 9; ++val) {
            if (isValid(row, col, val)) {
                grid[row][col] = val;
                solveRecursive(out);     // MODIFIED: pass output stream onward
                grid[row][col] = 0;      // backtrack and try next digit
            }
        }
    }

public:
    // Inherited constructor: initializes an empty board and zero solutions.
    SudokuSolver() : solutionCount(0) {
        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                grid[r][c] = 0;
            }
        }
    }

    // MODIFIED BY DALTON BROCKERT:
    // Reads exactly 81 valid tokens and rejects extra tokens, invalid symbols,
    // incomplete grids, or unreadable files. The board is reset before loading.
    bool loadFromFile(const std::string &filename) {
        std::ifstream inFile(filename.c_str());
        if (!inFile.is_open()) {
            return false;
        }

        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                grid[r][c] = 0;
            }
        }
        solutionCount = 0;

        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                std::string token;
                if (!(inFile >> token)) {
                    return false;        // fewer than 81 cells
                }

                if (token == "_") {
                    grid[r][c] = 0;
                } else if (token.size() == 1 &&
                           token[0] >= '1' && token[0] <= '9') {
                    grid[r][c] = token[0] - '0';
                } else {
                    return false;        // invalid cell token
                }
            }
        }

        // MODIFIED: reject trailing tokens; valid input has exactly 81 cells.
        std::string extraToken;
        if (inFile >> extraToken) {
            return false;
        }
        if (inFile.bad()) {
            return false;                // read error
        }

        return true;
    }

    // MODIFIED: console display remains available for the original puzzle.
    void printGrid() const {
        printGrid(std::cout);
    }

    // MODIFIED BY DALTON BROCKERT:
    // Writes all solutions and the final count to the provided output file.
    // For invalid clues or a valid puzzle with no solution, writes exactly
    // one line: "No solution found." (without a solution-count line).
    bool solveToFile(std::ostream &out) {
        solutionCount = 0;

        if (!cluesConsistent()) {
            out << "No solution found.\n";
            return true;
        }

        solveRecursive(out);

        if (solutionCount == 0) {
            out << "No solution found.\n";
        } else {
            out << "Solutions found: " << solutionCount << "\n";
        }
        return static_cast<bool>(out);
    }

    // Retained compatibility method: the original solve() still displays
    // results to the console, but uses the same validation/search logic.
    void solve() {
        solveToFile(std::cout);
    }
};

// ---------------------------------------------------------------------
// Block: main
// Inherited five-puzzle loop, modified to create solution1.txt - solution5.txt.
// ---------------------------------------------------------------------
int main() {
    const std::vector<std::string> puzzleFiles = {
        "puzzle1.txt",
        "puzzle2.txt",
        "puzzle3.txt",
        "puzzle4.txt",
        "puzzle5.txt"
    };

    for (std::size_t i = 0; i < puzzleFiles.size(); ++i) {
        const std::string &filename = puzzleFiles[i];
        const std::string outputFilename =
            "solution" + std::string(1, static_cast<char>('1' + i)) + ".txt";

        std::cout << "========================================\n";
        std::cout << filename << " -> " << outputFilename << "\n";
        std::cout << "========================================\n";

        // MODIFIED: always attempt to create the corresponding output file.
        std::ofstream outFile(outputFilename.c_str());
        if (!outFile.is_open()) {
            std::cerr << "Error: Could not create " << outputFilename << "\n";
            continue;
        }

        SudokuSolver solver;
        if (!solver.loadFromFile(filename)) {
            std::cerr << "Error: Missing, unreadable, or malformed input: "
                      << filename << "\n";
            // MODIFIED: give the output file a safe, deterministic result.
            outFile << "No solution found.\n";
            if (!outFile) {
                std::cerr << "Error: Could not write to "
                          << outputFilename << "\n";
            }
            continue;
        }

        std::cout << "Original Puzzle:\n";
        solver.printGrid();

        std::cout << "\nSolving; results are being written to "
                  << outputFilename << "...\n";

        if (!solver.solveToFile(outFile)) {
            std::cerr << "Error: Failed while writing " << outputFilename
                      << "\n";
        }
        outFile.close();
        if (outFile.fail()) {
            std::cerr << "Error: Failed to finish writing "
                      << outputFilename << "\n";
        }
        std::cout << "\n";
    }

    return 0;
}
